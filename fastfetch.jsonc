{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": {
      "1": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 6
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 12
    },
    "color": {
      "keys": "yellow",
      "title": "green"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "initsystem", "key": "init" },
    { "type": "bootmgr", "key": "bootmgr" },
    { "type": "host", "key": "host" },
    { "type": "board", "key": "board" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "pkgs" },
    { "type": "shell", "key": "shell" },
    { "type": "editor", "key": "editor" },
    { "type": "de", "key": "de" },
    { "type": "wm", "key": "wm" },
    { "type": "wmtheme", "key": "wmtheme" },
    { "type": "theme", "key": "theme" },
    { "type": "icons", "key": "icons" },
    { "type": "font", "key": "font" },
    { "type": "cursor", "key": "cursor" },
    { "type": "terminal", "key": "term" },
    { "type": "terminalfont", "key": "termfont" },
    { "type": "cpu", "key": "cpu", "showPeCoreCount": true },
    { "type": "gpu", "key": "gpu", "detectionMethod": "pci" },
    { "type": "memory", "key": "memory" },
    { "type": "swap", "key": "swap" },
    { "type": "disk", "key": "disk" },
    { "type": "localip", "key": "local ip" },
    { "type": "users", "key": "users" },
    "break",
    "colors"
  ]
}
