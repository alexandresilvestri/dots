{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 2000000
  },
  "bar": {
    "position": "left",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "ddd\nHH\nmm"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "cpu",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/cpu-status",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop"
        }
      ]
    }
  },
  "plugins": []
}
