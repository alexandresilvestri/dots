{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": {
      "1": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 6
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 10
    },
    "color": {
      "keys": "cyan",
      "title": "cyan"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    { "type": "os", "key": "os" },
    { "type": "wm", "key": "wm" },
    { "type": "packages", "key": "pkgs" },
    { "type": "shell", "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "editor", "key": "editor" },
    { "type": "de", "key": "de" },
    { "type": "cpu", "key": "cpu", "showPeCoreCount": true },
    { "type": "gpu", "key": "gpu", "detectionMethod": "pci", "driverSpecific": true, "format": "{name} {dedicated-total} VRAM" },
    { "type": "memory", "key": "memory" }
  ]
}
