{
  "cleanupPeriodDays": 14,
  "env": {
    "PLANNOTATOR_BROWSER": "firefox",
    "CAVEMAN_DEFAULT_MODE": "ultra"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "sentry-cli": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:mcp-builder": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:web-artifacts-builder": "off",
    "anthropic-skills:xlsx": "off",
    "chrome-devtools-mcp:a11y-debugging": "off",
    "chrome-devtools-mcp:chrome-devtools": "off",
    "chrome-devtools-mcp:chrome-devtools-cli": "off",
    "chrome-devtools-mcp:cookie-debugging": "off",
    "chrome-devtools-mcp:debug-optimize-lcp": "off",
    "chrome-devtools-mcp:memory-leak-debugging": "off",
    "chrome-devtools-mcp:troubleshooting": "off",
    "sentry:sentry-create-alert": "off",
    "sentry:sentry-debug-issue": "off",
    "sentry:sentry-fix-stack-traces": "off",
    "sentry:sentry-instrument": "off",
    "sentry:sentry-otel-exporter-setup": "off",
    "sentry:sentry-setup-releases": "off",
    "sentry:sentry-snapshots-cocoa": "off",
    "caveman:caveman-commit": "off",
    "caveman:caveman-discover": "off",
    "caveman:caveman-evidence-review": "off",
    "caveman:caveman-explore": "off",
    "caveman:caveman-learn": "off",
    "caveman:caveman-manage": "off",
    "caveman:caveman-optimize": "off",
    "caveman:caveman-review": "off",
    "caveman:caveman-setup": "off",
    "caveman:investigate-first": "off",
    "caveman:lean-build": "off",
    "caveman:migration": "off",
    "caveman:safe-refactor": "off",
    "caveman:surgical-patch": "off",
    "caveman:verify-and-stop": "off"
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Asana"
    },
    {
      "serverName": "claude.ai Atlassian Rovo"
    },
    {
      "serverName": "claude.ai Bitsight"
    },
    {
      "serverName": "claude.ai Box"
    },
    {
      "serverName": "claude.ai Canva"
    },
    {
      "serverName": "claude.ai Figma"
    },
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Calendar"
    },
    {
      "serverName": "claude.ai Google Docs"
    },
    {
      "serverName": "claude.ai Google Drive"
    },
    {
      "serverName": "claude.ai Google Sheets"
    },
    {
      "serverName": "claude.ai Google Slides"
    },
    {
      "serverName": "claude.ai HubSpot"
    },
    {
      "serverName": "claude.ai Intercom"
    },
    {
      "serverName": "claude.ai Linear"
    },
    {
      "serverName": "claude.ai Microsoft 365"
    },
    {
      "serverName": "claude.ai Microsoft Learn"
    },
    {
      "serverName": "claude.ai Slack"
    },
    {
      "serverName": "claude.ai monday.com"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-claude-coauthor.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-desktop.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-desktop.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "frontend-design@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "superpowers@claude-plugins-official": false,
    "sentry@claude-plugins-official": false,
    "design@synced": false,
    "engineering@synced": false,
    "data@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false,
    "pdf-viewer@synced": false,
    "github@synced": false,
    "postman@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": true
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "feedbackDrafts": "notify",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "kitty",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
